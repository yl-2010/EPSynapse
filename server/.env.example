PORT=3006
HOST=0.0.0.0

# Optional CORS allowlist (comma-separated)
# ALLOWED_ORIGINS=https://epsynapse.com,https://www.epsynapse.com,http://localhost:8080

# Optional table-demo fallback for the personal agent (Groq only).
# Students still paste their own key. Never commit the real value.
# Comma or space separated if you have more than one. Chat cycles on 429.
# DEMO_GROQ_KEY=
# DEMO_GROQ_KEYS=

# Microsoft 365 (OneDrive, OneNote, Outlook, Teams).
# Leave MICROSOFT_CLIENT_ID unset to use the Microsoft Office client with device code.
# That token only carries what Office already has (no OneNote read at EPS).
# Set it to our own app registration to switch to auth code + PKCE with named scopes.
# MICROSOFT_CLIENT_ID=
# Only for a Web platform registration that has a secret. Public clients leave this unset.
# MICROSOFT_CLIENT_SECRET=
# Tenant for the login URL. Defaults to the EPS tenant id. "organizations" also works.
# MICROSOFT_TENANT=
# Where Microsoft sends the auth code. Must match the app registration.
# MICROSOFT_REDIRECT_URI=https://api.epsynapse.com/v1/ms/callback
# Delegated scopes to ask for in app mode. Space separated.
# MICROSOFT_SCOPES=User.Read Files.ReadWrite Notes.ReadWrite Mail.ReadWrite Mail.Send Chat.ReadWrite offline_access openid profile email
# School IT address for the "please approve EPSynapse" request email.
# SCHOOL_IT_EMAIL=

# Sign in with Google. Web GIS + iOS GID. Extra audiences optional.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# GOOGLE_CLIENT_IDS=

# Optional Bearer token for POST /v1/admin/schools/:slug/roster
# ADMIN_KEY=

# Optional. Cursor SDK for one demo Google account. Never commit the real key.
# CURSOR_API_KEY=
# CURSOR_DEMO_EMAIL=
# CURSOR_PERSONAL_MODEL=composer-2.5

# Optional. Google emails that may use this Mac's Finder OneDrive and local Outlook/Teams sessions.
# STUDIO_DEMO_EMAIL=
# STUDIO_ONEDRIVE_DIR=
# STUDIO_MAIL_DIR=
# STUDIO_MAIL_SESSION=
# STUDIO_MAIL_MODULE=
# STUDIO_TEAMS_MODULE=
# STUDIO_ONENOTE_DIR=
# STUDIO_ONENOTE_SESSION=
# STUDIO_ONENOTE_MODULE=
