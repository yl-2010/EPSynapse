PORT=3006
# Bind address. Unset = 127.0.0.1 on the Mac (the Cloudflare Tunnel connects to
# loopback) and 0.0.0.0 on App Engine (detected from GOOGLE_CLOUD_PROJECT / GAE_ENV).
# Set it only to override that.
# HOST=127.0.0.1

# Browser origins allowed to call the API (comma-separated). Also the CSRF allowlist:
# a POST/PUT/PATCH/DELETE with an Origin header outside this list gets 403.
# Empty = no cross-origin browser access at all. Add http://localhost:8080 for local preview.
ALLOWED_ORIGINS=https://epsynapse.com,https://jype-six.vercel.app

# Optional table-demo fallback for the personal agent (Groq only).
# Students still paste their own key. Never commit the real value.
# Comma or space separated if you have more than one. Chat cycles on 429.
# DEMO_GROQ_KEY=
# DEMO_GROQ_KEYS=

# Microsoft 365 (OneDrive, OneNote, Outlook, Teams).
# Leave MICROSOFT_CLIENT_ID unset and Microsoft sign-in stays off. Never point this at a Microsoft first-party client id.
# Set it to our own app registration to turn on auth code + PKCE with named scopes.
# MICROSOFT_CLIENT_ID=
# Only for a Web platform registration that has a secret. Public clients leave this unset.
# MICROSOFT_CLIENT_SECRET=
# Tenant for the login URL. Defaults to the EPS tenant id. "organizations" also works.
# MICROSOFT_TENANT=
# Where Microsoft sends the auth code. Must match the app registration.
# MICROSOFT_REDIRECT_URI=https://api.epsynapse.com/v1/ms/callback
# Delegated scopes to ask for in app mode. Space separated.
# MICROSOFT_SCOPES=User.Read Files.ReadWrite Notes.ReadWrite Mail.ReadWrite Mail.Send Chat.ReadWrite offline_access openid profile email
# School IT address for the "please approve EPSynapse" request email.
# SCHOOL_IT_EMAIL=

# Canvas OAuth (EPS). Developer Key issued by Eastside Prep IT on eastsideprep.instructure.com.
# Leave CANVAS_OAUTH_CLIENT_ID unset and the Canvas sign-in stays off; students paste a token instead.
# CANVAS_OAUTH_CLIENT_ID=
# CANVAS_OAUTH_CLIENT_SECRET=
# CANVAS_OAUTH_HOST=https://eastsideprep.instructure.com
# Must match the redirect URI on the developer key exactly.
# CANVAS_OAUTH_REDIRECT_URI=https://api.epsynapse.com/v1/canvas/callback
# Only if IT enforces scopes on the key. Space separated. Unset asks for full student access.
# CANVAS_OAUTH_SCOPES=

# four11 (EPS schedules). Same kind of key epschedule uses. Off when unset.
# FOUR11_API_KEY=
# FOUR11_BASE=https://four11.eastsideprep.org

# Sign in with Google. Web GIS + iOS GID. Extra audiences optional.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# GOOGLE_CLIENT_IDS=

# Nightly four11 sync (like epschedule). Off unless FOUR11_API_KEY is set too.
# Mac: FOUR11_NIGHTLY=1 runs it in-process at 00:15 local time every day.
# App Engine: cron.yaml hits GET /internal/four11/sync-all instead; leave this unset there.
# FOUR11_NIGHTLY=
# Optional operator key. `Authorization: Bearer <ADMIN_KEY>` on GET /internal/four11/sync-all
# runs the nightly sync by hand. Unset = only App Engine cron can call it.
# ADMIN_KEY=

# Secrets at rest (students.js via crypto.js). 32 bytes, base64 or hex.
# Generate: openssl rand -base64 32
# Unset = plaintext on disk with a warning at boot. Once set, run
# `node --env-file=.env tools/reseal-students.mjs` to seal existing student files.
# Losing this key loses every stored Canvas token, model key, and Microsoft token.
# DATA_ENCRYPTION_KEY=
